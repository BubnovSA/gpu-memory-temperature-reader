[Unit]
Description=GPU Governor (NVML power/clock manager)
After=multi-user.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
EnvironmentFile=-/etc/gpu-governor/config
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/gpu-governor.py
Restart=on-failure
RestartSec=5
# Exit code 2 means config error — don't hot-loop, make the admin fix it.
RestartPreventExitStatus=2

# Give the daemon time to restore factory defaults on shutdown.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
